## 1.3.6.1.4.1.56521.389.2.77.3 (attributeTypes)
attributeTypes ( 1.3.6.1.4.1.56521.389.2.77.3.1 NAME 'stateContext'
  DESC 'The distinguished name of the state entry'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
  EQUALITY distinguishedNameMatch
  SINGLE-VALUE
  USAGE dSAOperation
  NO-USER-MODIFICATION
  X-ORIGIN 'Jesse Coretta'
  X-DO-NOT-ADVERTISE 'TRUE' )
attributeTypes ( 1.3.6.1.4.1.56521.389.2.77.3.2 NAME 'stateAvailable'
  DESC 'Whether the DSA is available for general use'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  EQUALITY booleanMatch
  USAGE directoryOperation
  NO-USER-MODIFICATION
  X-ORIGIN 'Jesse Coretta'
  X-DO-NOT-ADVERTISE 'TRUE' )

## 1.3.6.1.4.1.56521.389.2.77.5 (objectClasses)
objectClasses ( 1.3.6.1.4.1.56521.389.2.77.5.1 NAME 'goDirState'
  DESC 'DSA state root class'
  SUP top
  STRUCTURAL
  MUST ( cn
       $ stateAvailable )
  X-ORIGIN 'Jesse Coretta'
  X-DO-NOT-ADVERTISE 'TRUE' )
