objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.1 NAME 'metaLDAPSyntax'
	DESC 'Tokenized abstraction of an LDAP Syntax Description'
	SUP top
	STRUCTURAL
	MUST metaDefNumericOID
	MAY  ( metaDefDesc 
             $ metaDefXOrigin
             $ metaDefXPattern
	     $ metaDefXNotHuman )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.2 NAME 'metaMatchingRule'
	DESC 'Tokenized abstraction of a Matching Rule'
	SUP top
	STRUCTURAL
	MUST ( metaDefNumericOID
             $ metaDefSyntax )
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.3 NAME 'metaAttributeType'
	DESC 'Tokenized abstraction of a Attribute Type'
	SUP top
	STRUCTURAL
	MUST metaDefNumericOID
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefSyntax
             $ metaDefUB
             $ metaDefEquality
             $ metaDefSubstring
             $ metaDefOrdering
             $ metaDefUsage
             $ metaDefSupT
             $ metaDefObsolete
             $ metaDefSingleValue
             $ metaDefNoUserMods
             $ metaDefCollective
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.4 NAME 'metaMatchingRuleUse'
	DESC 'Tokenized abstraction of a Matching Rule Use'
	SUP top
	STRUCTURAL
	MUST metaDefNumericOID
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefApplies
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.5 NAME 'metaObjectClass'
	DESC 'Tokenized abstraction of an Object Class'
	SUP top
	STRUCTURAL
	MUST metaDefNumericOID
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefMust
             $ metaDefMay
             $ metaDefKind
             $ metaDefSupC
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.6 NAME 'metaDITContentRule'
	DESC 'Tokenized abstraction of a DIT Content Rule'
	SUP top
	STRUCTURAL
	MUST metaDefNumericOID
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefAux
             $ metaDefMust
             $ metaDefMay
             $ metaDefNot
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.7 NAME 'metaNameForm'
	DESC 'Tokenized abstraction of a Name Form'
	SUP top
	STRUCTURAL
	MUST ( metaDefNumericOID
             $ metaDefOC )
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefMust
             $ metaDefMay
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
objectClasses ( 1.3.6.1.4.1.56521.389.2.44.5.8 NAME 'metaDITStructureRule'
	DESC 'Tokenized abstraction of a DIT Structure Rule'
	SUP top
	STRUCTURAL
	MUST ( metaDefRuleID
             $ metaDefForm )
	MAY  ( metaDefName
             $ metaDefDesc
             $ metaDefSupR
             $ metaDefObsolete
             $ metaDefXOrigin )
	X-ORIGIN 'Jesse Coretta' )
