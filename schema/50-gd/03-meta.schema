attributeTypes ( 1.3.6.1.4.1.56521.389.2.44.3.1 NAME 'metaDefNumericOID'	
	DESC 'Numeric OID held by a definition'
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.38
	EQUALITY objectIdentifierMatch
	SINGLE-VALUE
	NO-USER-MODIFICATION
	X-ORIGIN 'Jesse Coretta' )
attributeTypes ( 1.3.6.1.4.1.56521.389.2.44.3.2 NAME 'metaDefRuleID'
	DESC 'Integer identifier of a structure rule'
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
	EQUALITY integerMatch
	ORDERING integerOrderingMatch
	SINGLE-VALUE
	NO-USER-MODIFICATION
	X-ORIGIN 'Jesse Coretta' )
