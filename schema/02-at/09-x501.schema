attributeTypes ( 2.5.18.9
  NAME 'hasSubordinates'
  DESC 'X.501, cl. 14.4.4: Whether an entry has subordinates'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE directoryOperation
  X-ORIGIN 'ITU-T Rec. X.501' )

attributeTypes ( 2.5.18.17
  NAME 'hierarchyLevel'
  DESC 'X.501, cl. 14.10: The logical depth of an hierarchical group member entry'
  EQUALITY integerMatch
  ORDERING integerOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE directoryOperation
  X-ORIGIN 'ITU-T Rec. X.501' )

attributeTypes ( 2.5.18.18
  NAME 'hierarchyBelow'
  DESC 'X.501, cl. 14.10: Whether the hierarchical group member entry has any children'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE directoryOperation
  X-ORIGIN 'ITU-T Rec. X.501' )

attributeTypes ( 2.5.18.19
  NAME 'hierarchyParent'
  DESC 'X.501, cl. 14.10: The distinguished name of the parent entry of the hierarchical child'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE directoryOperation
  X-ORIGIN 'ITU-T Rec. X.501' )

attributeTypes ( 2.5.18.20
  NAME 'hierarchyTop'
  DESC 'X.501, cl. 14.10: The distinguished name of entry residing at the top (root) of the hierarchical group structure'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE directoryOperation
  X-ORIGIN 'ITU-T Rec. X.501' )

## DSEType ::= BIT STRING {
##    root            (0),         -- root DSE
##    glue            (1),         -- represents knowledge of a name only
##    cp              (2),         -- context prefix
##    entry           (3),         -- object entry
##    alias           (4),         -- alias entry
##    subr            (5),         -- subordinate reference
##    nssr            (6),         -- non-specific subordinate reference
##    supr            (7),         -- superior reference
##    xr              (8),         -- cross reference
##    admPoint        (9),         -- administrative point
##    subentry        (10),        -- subentry
##    shadow          (11),        -- shadow copy
##    immSupr         (13),        -- immediate superior reference
##    rhob            (14),        -- rhob information
##    sa              (15),        -- subordinate reference to alias entry
##    dsSubentry      (16),        -- DSA Specific subentry
##    familyMember    (17),        -- family member
##    ditBridge       (18)}        -- DIT bridge reference
##    --writeableCopy (19) writeable copy (currently not used)
attributeTypes ( 2.5.1.0.9.0
  NAME 'dseType'
  DESC 'X.501, cl. 23.4.2: The particular purpose or role of a DSE'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.20
  EQUALITY bitStringMatch
  SINGLE-VALUE
  NO-USER-MODIFICATION
  USAGE dSAOperation
  X-ORIGIN 'ITU-T Rec. X.501' )
